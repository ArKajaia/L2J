<?xml version="1.0" encoding="UTF-8"?>
<list xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="xsd/VillageSiege.xsd">
	<!--
		Village Under Siege (config/Custom/VillageSiege.ini): once a day, one village after the other, monsters of the
		hunting grounds around a starting village attack its entrances. The defenders hold the gate standard of each
		entrance, the village guards wait behind it, and contribution is paid in Defence Medals.

		village
		  id             the key used in VillageSiegeOrder and by //villagesiege
		  name           shown in announcements and on the Defence Force Board
		  town           the name of the village's TownZone (data/zones/custom_town.xml)
		  gatekeeper     the village gatekeeper npc: the heart of the village, and the Defence Force Board stands near it
		  guardLook      the npc whose look the siege guards borrow (one of the village's own guards)
		  referenceItem  sets how many medals the village pays: VillageSiegeHoursPerReferenceItem hours of fighting
		                 there pay for this item (its retail price / VillageSiegeAdenaPerMedal medals)
		  level          optional: the level of the siege's monsters. By default the average level of the monsters
		                 living around the village (capped at VillageSiegeMaxPlayerLevel)

		entrance (optional) a fixed entrance: the gate standard stands at x, y, z. Without any, the entrances are found
		  on their own: the roads the monsters of the hunting grounds around take into the village (the path from each
		  ground to the gatekeeper, where it crosses into the TownZone). //villagesiege entrances <id> shows them, with
		  lines to paste here to keep them.
	-->
	<village id="talking_island" name="Talking Island Village" town="Talking Island" gatekeeper="30006" guardLook="30039" referenceItem="68" />
	<village id="elven" name="Elven Village" town="Elven Village" gatekeeper="30146" guardLook="30216" referenceItem="68" />
	<village id="dark_elven" name="Dark Elven Village" town="Dark Elven Village" gatekeeper="30134" guardLook="30346" referenceItem="68" />
	<village id="orc" name="Orc Village" town="Orc Village" gatekeeper="30576" guardLook="30577" referenceItem="68" />
	<village id="dwarven" name="Dwarven Village" town="Dwarven Village" gatekeeper="30540" guardLook="30541" referenceItem="68" />
	<village id="kamael" name="Kamael Village" town="Kamael Village" gatekeeper="32163" guardLook="32174" referenceItem="68" />
	<village id="gludin" name="Gludin Village" town="Gludin Village" gatekeeper="30320" guardLook="30379" referenceItem="124" />
	<village id="gludio" name="Town of Gludio" town="Gludio Castle Town" gatekeeper="30256" guardLook="30331" referenceItem="124" />
	<village id="dion" name="Town of Dion" town="Dion Castle Town" gatekeeper="30059" guardLook="30071" referenceItem="84" />
</list>
