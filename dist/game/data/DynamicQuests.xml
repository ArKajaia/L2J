	<!-- ============================================================================================ -->
	<!-- 1. Wanted: a named monster is loose. The board posts its bounty; find its trail, then hunt it down. -->
	<template id="1" name="Wanted: {target}" category="Bounty">
		<trigger type="BOARD_DAILY" weight="14" />
		<eligibility minLevel="15" dailyLimit="3" />
		<context key="target" pool="bountyNames" />
		<context key="gang" pool="gangs" />
		<stage name="The Last Sighting" timeLimit="900">
			<text>{target} was last seen near {near}. Search the place on your radar for its trail.</text>
			<objective type="INVESTIGATE" clues="1" clueNpc="900506" searchTime="6" firstMin="0" firstMax="400" lines="bountyClues" ambushChance="20" ambushCount="2" text="Find {target}'s trail near {near}." />
			<on event="SUCCESS" action="NEXT" />
			<on event="TIMEOUT" action="FAIL" text="The trail has gone cold." />
		</stage>
		<stage name="The Hunt" timeLimit="1200">
			<text>The trail leads on. {target} is somewhere ahead - follow the radar and finish it.</text>
			<objective type="KILL" source="QUEST" named="true" at="LAST" spawnMin="700" spawnMax="1200" tierBonus="2" guards="2" guardTitle="{gang}" escalate="FLEE" fleeGuards="2" bonus="HP_ABOVE:30" killText="{target} has fallen!" fleeText="{target} caught your scent and fled! Follow the radar." />
			<objective type="COLLECT" optional="true" source="AREA" name="tokens of {gang}" count="5" chance="35" />
			<on event="SUCCESS" action="FOLLOW_UP" target="1" chance="20" text="Among the remains: a token of {gang}. There will be more of them." />
			<on event="SUCCESS" action="COMPLETE" />
			<on event="TIMEOUT" action="ESCALATE" max="1" extraTime="600" text="{target} has slipped away to a new lair! You have one more chance." />
		</stage>
		<reward exp="3" sp="0.1" adenaPerLevel="1200" table="bounty" />
		<text key="title">Wanted</text>
		<text key="offer">A beast of the wilds has grown bold and killed travellers near the roads. The board pays well for its head. Its trail starts in the hunting grounds of your strength.</text>
		<text key="success">The bounty is yours. The roads are a little safer tonight.</text>
		<text key="heraldLine">You there! A bounty has been posted, and you look like a hunter.</text>
	</template>

	<!-- 2. Caravan Crossing: a caravan must cross a hunting ground; lead it to the next town through the ambushes. -->
	<template id="2" name="Caravan Crossing" category="Escort">
		<trigger type="BOARD_DAILY" weight="8" />
		<trigger type="TIMER" chance="15" />
		<eligibility minLevel="15" dailyLimit="2" />
		<context key="caravan" pool="caravans" />
		<stage name="The Caravan Master" timeLimit="900">
			<text>{caravan} waits at the edge of the wilds near {near}. Find its master on your radar.</text>
			<objective type="INTERACT" npc="900509" at="AREA" spawnMin="0" spawnMax="300" dialog="The road ahead is thick with brigands and worse. We leave now, with you leading. Keep them off the wagon and we'll all live to see town." button="Let's move" line="Wagons, roll out!" />
			<on event="SUCCESS" action="NEXT" />
		</stage>
		<stage name="The Crossing" timeLimit="1800">
			<text>Lead the wagon towards {dest}. When it stops, the ambushers come - beat them off.</text>
			<objective type="ESCORT" escortee="900502" at="LAST" dest="TOWN" legs="4" legMin="900" legMax="1400" ambushCount="3" meter="100" drain="1.2" meterName="wagon" bonus="METER_ABOVE:75" startText="Hyah! Lead the way, we follow." ambushText="Brigands! Protect the wagon!" arriveText="We're through! You've earned your pay." failText="The wagon is lost, and the cargo with it." />
			<on event="SUCCESS" action="FOLLOW_UP" target="1" chance="25" text="The caravan master whispers: the brigands answer to someone. The board will want to know." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<reward exp="3" sp="0.1" adenaPerLevel="1500" table="shots">
			<item id="736" count="2" scaled="false" /> <!-- Scroll of Escape -->
		</reward>
		<text key="title">Caravan Crossing</text>
		<text key="offer">A caravan must cross dangerous land and no guard can be spared. Lead it from the wilds to the next town and keep the wagon in one piece.</text>
		<text key="success">The caravan made it through. The merchants pay what they promised, and a little more.</text>
		<text key="failLogout">You left the caravan to its fate.</text>
		<text key="heraldLine">Adventurer! A caravan needs an escort, right now. Will you help?</text>
	</template>

	<!-- 3. Kidnapped: follow the kidnappers' trail, clear their hideout and bring the captive home. -->
	<template id="3" name="Kidnapped: {hostage}" category="Rescue" requester="townsfolk">
		<trigger type="NPC_INTERACTION" weight="8" />
		<trigger type="TIMER" chance="12" />
		<eligibility minLevel="20" dailyLimit="2" />
		<context key="hostage" pool="hostages" />
		<context key="gang" pool="gangs" />
		<stage name="The Trail" timeLimit="1200">
			<text>{hostage} was taken on the road near {near}. Find out where they went.</text>
			<objective type="INVESTIGATE" clues="2" clueNpc="900506" searchTime="8" spacingMin="900" spacingMax="1500" lines="kidnapClues" ambushChance="25" ambushCount="2" />
			<on event="SUCCESS" action="NEXT" />
			<on event="TIMEOUT" action="FAIL" text="The trail has gone cold. {hostage} is lost." />
		</stage>
		<stage name="The Hideout" timeLimit="900">
			<text>The trail ends at {gang}'s hideout. Clear it out before they move {hostage} again.</text>
			<objective type="KILL" source="QUEST" count="4" at="LAST" spawnMin="800" spawnMax="1300" tierBonus="1" title="{gang}" escalate="FLEE_LEADER" leaderTitle="Leader of {gang}" leaderTierBonus="2" text="Clear out {gang}'s hideout." />
			<on event="SUCCESS" action="NEXT" />
			<on event="TIMEOUT" action="ESCALATE" max="1" extraTime="600" text="{gang} moved {hostage} to another hideout - and their leader is with them now!" />
		</stage>
		<stage name="The Way Home" timeLimit="1500">
			<text>{hostage} is free, but shaken. Lead them safely towards {dest}.</text>
			<objective type="ESCORT" escortee="900503" at="LAST" dest="TOWN" legs="3" legMin="900" legMax="1400" ambushCount="2" meter="100" drain="1.5" meterName="courage" bonus="NO_DEATHS" startText="Thank the gods... please, get me home." ambushText="They are coming back for me!" arriveText="Home... I never thought I'd see it again." failText="{gang} took {hostage} back, and this time for good." />
			<on event="SUCCESS" action="FOLLOW_UP" target="1" chance="30" text="{hostage} heard their leader's name. The board will post a bounty." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<reward exp="3.5" sp="0.1" adenaPerLevel="1500" table="bounty" />
		<text key="title">Kidnapped!</text>
		<text key="offer">{requester} begs for help: someone dear was dragged off the road by brigands. Follow their trail, free the captive and bring them home.</text>
		<text key="success">{hostage} is home, and a whole town owes you.</text>
		<text key="failLogout">With nobody left to follow the trail, {hostage} is lost.</text>
		<text key="heraldLine">Please, adventurer! They took someone - brigands, on the road! Help us!</text>
	</template>

	<!-- 4. Blacksmith's Order: a blacksmith of the town needs crafting materials of your grade. -->
	<template id="4" name="Order for {requester}" category="Request" requester="blacksmith">
		<trigger type="NPC_INTERACTION" weight="10" />
		<eligibility minLevel="10" dailyLimit="2" />
		<stage name="The Order" timeLimit="7200">
			<text>Bring {goods} to a Notice Board for {requester}.</text>
			<objective type="DELIVER" table="blacksmith" kinds="2" bonus="FAST:50" />
			<objective type="COLLECT" optional="true" source="AREA" name="lumps of cold iron" count="6" chance="30" text="If you can, bring cold iron from the {monster} near {near} too." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<reward exp="1.5" sp="0.1" adenaPerLevel="2500" table="scrolls" />
		<text key="title">Blacksmith's Order</text>
		<text key="offer">{requester} has more orders than materials. Bring what the forge needs - the grade you work with yourself - and be paid well above the shop price.</text>
		<text key="success">The forge roars again. {requester} pays in coin and in favours.</text>
	</template>

	<!-- 5. Townsfolk Requests: one small task from a pool, for a townsman of the board's town. -->
	<template id="5" name="A Favour for {requester}" category="Request" requester="townsfolk" entryStages="1,2,3,5">
		<trigger type="NPC_INTERACTION" weight="14" />
		<eligibility minLevel="10" dailyLimit="4" />
		<stage name="Supplies" timeLimit="3600">
			<objective type="DELIVER" table="goods" kinds="1" text="Bring {goods} to a Notice Board for {requester}." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<stage name="Pests" timeLimit="2400">
			<objective type="COLLECT" source="AREA" name="pelts" count="6" chance="45" text="Bring {requester} 6 pelts of the {monster} near {near}." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<stage name="A Letter" timeLimit="2400">
			<objective type="REACH" dest="TOWN_NEAR" radius="400" text="Carry {requester}'s letter to the Notice Board of {dest}." />
			<on event="SUCCESS" action="NEXT" />
		</stage>
		<stage name="The Answer" timeLimit="2400">
			<objective type="REACH" dest="HOME" radius="400" text="Bring the answer back to {town}." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<stage name="Wolves at the Door" timeLimit="2400">
			<objective type="KILL" source="AREA" count="8" text="Thin out the {monster} near {near} that trouble {requester}." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<reward exp="1" sp="0.1" adenaPerLevel="700" table="supplies" />
		<text key="title">A Favour</text>
		<text key="offer">{requester} needs a hand with something small. It won't take long, and they will remember it.</text>
		<text key="success">{requester} thanks you warmly.</text>
	</template>

	<!-- 6. Outbreak: a hunting ground's monsters multiply. Everyone near trims the surge before it spreads. -->
	<template id="6" name="Outbreak of {monster}" category="World event" scope="WORLD">
		<trigger type="TIMER" chance="35" />
		<eligibility minLevel="20" />
		<stage name="The Surge" timeLimit="1200">
			<text>The {monster} near {near} are multiplying. Trim them down before they spread!</text>
			<objective type="CULL" count="15" perPlayer="4" max="60" radius="800" percent="80" alphaTitle="Alpha of the Swarm" alphaTierBonus="3" spreadMin="1500" spreadMax="2500" />
			<on event="SUCCESS" action="COMPLETE" />
			<on event="TIMEOUT" action="ESCALATE" max="1" extraTime="900" text="The outbreak spreads, and an alpha leads it!" />
		</stage>
		<reward exp="3" sp="0.1" adenaPerLevel="1200" table="shots">
			<item id="736" count="1" scaled="false" /> <!-- Scroll of Escape -->
		</reward>
		<text key="title">Outbreak</text>
		<text key="worldAnnounce">Outbreak! The {monster} near {near} are multiplying out of control. Hunters of level {level} or so, trim them down!</text>
		<text key="worldSuccess">The outbreak near {near} has been trimmed down. Well fought!</text>
		<text key="worldFail">The outbreak near {near} could not be stopped. The beasts scatter into the land.</text>
		<text key="success">The surge is broken. Everyone who fought shares the reward.</text>
	</template>

	<!-- 7. Hold the Line: a camp in the wilds is about to be overrun. Hold its banner through the waves. -->
	<template id="7" name="Hold the Line" category="Defence">
		<trigger type="BOARD_DAILY" weight="8" />
		<trigger type="TIMER" chance="10" />
		<eligibility minLevel="20" dailyLimit="2" />
		<context key="captain" pool="captains" />
		<stage name="The Camp" timeLimit="900">
			<text>{captain}'s camp near {near} expects an attack. Report to the captain.</text>
			<objective type="INTERACT" npc="900510" at="AREA" spawnMin="0" spawnMax="300" dialog="Our scouts saw them gathering - too many for us alone. Stand by our banner. If it falls, the camp falls with it." button="I'll hold the line" line="To arms! Here they come!" />
			<on event="SUCCESS" action="NEXT" />
		</stage>
		<stage name="The Assault" timeLimit="1200">
			<text>Defend the banner through every wave, and break their leader.</text>
			<objective type="DEFEND" target="900505" at="LAST" waves="5" waveCount="3" waveInterval="45" prep="20" boss="true" bossTierBonus="2" bossTitle="Warband Leader" meter="100" drain="1" meterName="banner" bonus="METER_ABOVE:60" />
			<on event="SUCCESS" action="COMPLETE" />
			<on event="FAILURE" action="FAIL" text="The banner has fallen, and the camp with it." />
		</stage>
		<reward exp="3.5" sp="0.1" adenaPerLevel="1500" table="bounty" />
		<text key="title">Hold the Line</text>
		<text key="offer">A camp in the wilds is about to be overrun. Its captain asks for anyone who can hold a line.</text>
		<text key="success">The camp stands. {captain} salutes you.</text>
		<text key="failLogout">You left the camp to its fate.</text>
		<text key="heraldLine">The camp nearby is under attack! They need every blade - come quickly!</text>
	</template>

	<!-- 8. Lost Expedition: three clues lead to a lost expedition; save its survivor or slay what took it. -->
	<template id="8" name="The Lost Expedition" category="Mystery">
		<trigger type="BOARD_DAILY" weight="8" />
		<trigger type="PLAYER_ACTION" action="KILL" chance="0.02" />
		<eligibility minLevel="20" dailyLimit="2" />
		<context key="expedition" pool="expeditions" />
		<context key="beast" pool="beasts" />
		<stage name="The Trail" timeLimit="1800">
			<text>{expedition} vanished near {near}. Follow their traces.</text>
			<objective type="INVESTIGATE" clues="3" clueNpc="900506" searchTime="8" spacingMin="1000" spacingMax="1800" lines="expeditionClues" ambushChance="30" ambushCount="2" />
			<on event="SUCCESS" action="STAGE" target="2" chance="50" />
			<on event="SUCCESS" action="STAGE" target="3" />
			<on event="TIMEOUT" action="FAIL" text="The trail is lost. {expedition} will never be found." />
		</stage>
		<stage name="The Survivor" timeLimit="1500">
			<text>One of {expedition} is alive! Lead the survivor towards {dest}.</text>
			<objective type="ESCORT" escortee="900504" at="LAST" dest="TOWN" legs="3" legMin="900" legMax="1400" ambushCount="2" meter="100" drain="1.2" meterName="strength" startText="You found me... I can walk, if you lead." arriveText="Safe at last. The others... I'll tell the board everything." failText="The survivor didn't make it." />
			<on event="SUCCESS" action="FOLLOW_UP" target="8" chance="30" text="The survivor speaks of a second camp, further out." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<stage name="The Culprit" timeLimit="1200">
			<text>Nobody survived. Something lairs where the trail ends - {beast}. Slay it.</text>
			<objective type="KILL" source="QUEST" named="false" count="1" at="LAST" spawnMin="500" spawnMax="900" tierBonus="2" guards="3" title="{beast}" text="Slay {beast}." />
			<on event="SUCCESS" action="FOLLOW_UP" target="8" chance="30" text="In its lair: a map of the expedition's route - and a second camp, further out." />
			<on event="SUCCESS" action="COMPLETE" />
			<on event="TIMEOUT" action="FAIL" text="{beast} has gone to ground." />
		</stage>
		<reward exp="3.5" sp="0.1" adenaPerLevel="1500" table="bounty" />
		<text key="title">The Lost Expedition</text>
		<text key="offer">An expedition into the wilds has not come back. Find out what happened to them - and bring back anyone you can.</text>
		<text key="success">You learned the expedition's fate. The board records your name.</text>
		<text key="failLogout">You left the trail, and it has gone cold.</text>
		<text key="heraldLine">You have sharp eyes. An expedition went missing near here - will you look for them?</text>
	</template>

	<!-- 9. Monster Nest: nests are breeding monsters in a hunting ground. Burn them all. -->
	<template id="9" name="The Nests near {near}" category="Purge">
		<trigger type="BOARD_DAILY" weight="8" />
		<trigger type="WORLD_STATE" counter="AREA_KILLS" threshold="120" chance="30" />
		<eligibility minLevel="15" dailyLimit="2" />
		<stage name="The Nests" timeLimit="1200">
			<text>Nests are breeding {monster} near {near}. Stand next to each nest to burn it, while their brood fights back.</text>
			<objective type="DESTROY" nests="3" nestNpc="900507" spawnEvery="20" maxAlive="3" burnTime="6" radius="1200" broodTitle="Brood Mother" broodTierBonus="2" bonus="NO_DEATHS" />
			<on event="SUCCESS" action="COMPLETE" />
			<on event="TIMEOUT" action="ESCALATE" max="1" extraTime="600" text="The nests are swarming, and their mother has come!" />
		</stage>
		<reward exp="3" sp="0.1" adenaPerLevel="1200" table="bounty" />
		<text key="title">Monster Nests</text>
		<text key="offer">The hunting grounds teem with more beasts every day: something is breeding them. Find the nests and burn them.</text>
		<text key="success">The nests are ash. The land can breathe again.</text>
		<text key="failLogout">The nests breed on without you.</text>
		<text key="heraldLine">All this slaughter has stirred the nests nearby. Someone has to burn them - you?</text>
	</template>

	<!-- 10. Urgent Courier: a sealed package must reach another town's board on foot, through ambushes. -->
	<template id="10" name="Urgent Courier" category="Courier" requester="gatekeeper">
		<trigger type="NPC_INTERACTION" weight="10" />
		<trigger type="BOARD_DAILY" weight="5" />
		<eligibility minLevel="15" dailyLimit="2" />
		<stage name="The Package" timeLimit="2400">
			<text>Carry the sealed package to the Notice Board of {dest} on foot. A teleport breaks the seal.</text>
			<objective type="REACH" dest="TOWN_FAR" minDistance="8000" maxDistance="40000" radius="400" noTeleport="true" ambushEvery="90" ambushCount="2" ambushTitle="Highwayman" bonus="HP_ABOVE:50" teleportText="The seal shatters as you pass through the ether - the package is ruined." />
			<on event="SUCCESS" action="COMPLETE" />
		</stage>
		<reward exp="2" sp="0.1" adenaPerLevel="2000" table="supplies" />
		<text key="title">Urgent Courier</text>
		<text key="offer">A sealed package must reach another town, and it can't go through the gatekeepers - the seal breaks in the ether. Carry it on foot, and watch the roads.</text>
		<text key="success">The package arrives, seal unbroken. The recipient pays the courier's fee.</text>
		<text key="failLogout">The package never arrived.</text>
	</template>
</list>
