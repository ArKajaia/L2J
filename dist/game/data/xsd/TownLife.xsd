<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:complexType name="point">
		<xs:attribute name="x" type="xs:integer" use="required" />
		<xs:attribute name="y" type="xs:integer" use="required" />
		<xs:attribute name="z" type="xs:integer" use="required" />
	</xs:complexType>
	<xs:element name="list">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="town">
					<xs:complexType>
						<xs:choice minOccurs="0" maxOccurs="unbounded">
							<xs:element name="square" type="point" />
							<xs:element name="tavern">
								<xs:complexType>
									<xs:attribute name="npc" type="xs:positiveInteger" />
									<xs:attribute name="x" type="xs:integer" />
									<xs:attribute name="y" type="xs:integer" />
									<xs:attribute name="z" type="xs:integer" />
								</xs:complexType>
							</xs:element>
							<xs:element name="homebound">
								<xs:complexType>
									<xs:attribute name="npc" type="xs:positiveInteger" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:choice>
						<xs:attribute name="region" type="xs:token" use="required" />
						<xs:attribute name="name" type="xs:string" />
						<xs:attribute name="size">
							<xs:simpleType>
								<xs:restriction base="xs:token">
									<xs:enumeration value="small" />
									<xs:enumeration value="medium" />
									<xs:enumeration value="large" />
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="children" type="xs:boolean" />
					</xs:complexType>
				</xs:element>
				<xs:element name="harbor">
					<xs:complexType>
						<xs:attribute name="name" type="xs:string" use="required" />
						<xs:attribute name="wharf" type="xs:positiveInteger" use="required" />
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>
