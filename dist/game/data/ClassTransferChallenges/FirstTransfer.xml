<?xml version="1.0" encoding="UTF-8"?>
<list xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../xsd/ClassTransferChallenges.xsd">
	<!--
	Alternative Class Transfer Challenges - First Class Transfer (Class Master 900001).

	All trials take place in a private copy of the Kamaloka "Hall of the Abyss" room: the challenger appears at the entrance
	(-88429, -220629) and the trial circle / boss dais is at (-88998, -220077), about 800 units away, so there is little walking.

	Challenge attributes: id, name, stage (FIRST_TRANSFER / SECOND_TRANSFER / THIRD_TRANSFER), difficulty (display only),
	duration (time limit, seconds), parTime (clear within it for the parBonus rewards), minLevel (on top of the Class Master
	level), classes (comma separated class ids allowed; empty = whoever the mappings send here).
	<omens>: Hot Zone modifiers an attempt may roll; the rolled one applies to the whole trial instance.
	<objectives>: done in order. See the README for every objective type and its attributes.
	<spawn>: npcId, count (alive at once), x, y, z, heading, radius (scatter), championTier (1-3), variant (MAGE / THIEF),
	         waves (Wave Champion phases), arenaBuffs (Survival Arena challenger buffs every phase), enrageSeconds.
	<twists>: INVADER - a rival fake player invades after "afterObjective" objectives, "chance" percent of the attempts.
	<rewards>: granted once on clear: <item id count parBonus />, <arenaCoins count parBonus />, <sealedCache />, <exp count />, <sp count />.
	<mapping>: which challenge a player takes. Checked in order CLASS (the class, then its parent classes) -> RACE -> ARCHETYPE (FIGHTER / MAGE) -> GENERIC.
	-->
	<challenge id="first_vanguard" name="Trial of the Vanguard" stage="FIRST_TRANSFER" difficulty="Normal" duration="1200" parTime="600">
		<description>Prove your blade against the orc recruits of the Hall, win back the Trial Marks - mind the Mark Thief - and defeat the Trial Guardian, who does not fall the first time.</description>
		<entry x="-88429" y="-220629" z="-7903" heading="24740" />
		<guide npcId="900240" x="-88471" y="-220672" z="-7903" heading="24740" />
		<omens>
			<omen name="GENEROUS_SPIRITS" />
			<omen name="KILL_STREAK" />
			<omen name="VAMPIRIC_HUNT" />
			<omen name="VETERAN_GROUNDS" />
			<omen name="FRAGILE_GROUND" />
		</omens>
		<objectives>
			<objective type="KILL" text="Defeat the Trial Recruits" count="10">
				<spawn npcId="900200" count="3" x="-88714" y="-220353" z="-7900" radius="200" />
				<spawn npcId="900200" count="1" x="-88575" y="-220210" z="-7900" radius="100" />
			</objective>
			<objective type="COLLECT" text="Win back the Trial Marks" count="3" itemId="8940" chance="50" thiefBonus="2">
				<spawn npcId="900200" count="3" x="-88714" y="-220353" z="-7900" radius="200" />
				<spawn npcId="900203" count="1" x="-88853" y="-220496" z="-7900" variant="THIEF" />
			</objective>
			<objective type="REACH" text="Step into the Trial Circle" x="-88998" y="-220077" z="-7892" radius="200" npcId="900243" />
			<objective type="BOSS" text="Defeat the Trial Guardian">
				<spawn npcId="900204" x="-88856" y="-220215" z="-7896" heading="57508" waves="2" />
			</objective>
			<objective type="TALK" text="Speak with the Trial Master" npcId="900241" x="-88998" y="-220077" z="-7892" heading="57508" />
		</objectives>
		<rewards>
			<arenaCoins count="10" parBonus="5" />
			<sealedCache />
		</rewards>
	</challenge>
	<challenge id="first_arcane" name="Trial of the Arcane" stage="FIRST_TRANSFER" difficulty="Normal" duration="1200" parTime="600">
		<description>Overpower the orc spellcasters of the Hall, awaken the three Trial Seals, hold your ground against the onslaught, and defeat the Trial Guardian.</description>
		<entry x="-88429" y="-220629" z="-7903" heading="24740" />
		<guide npcId="900240" x="-88471" y="-220672" z="-7903" heading="24740" />
		<omens>
			<omen name="GENEROUS_SPIRITS" />
			<omen name="KILL_STREAK" />
			<omen name="VAMPIRIC_HUNT" />
			<omen name="VETERAN_GROUNDS" />
			<omen name="FRAGILE_GROUND" />
		</omens>
		<objectives>
			<objective type="KILL" text="Defeat the Arcane Skirmishers" count="6">
				<spawn npcId="900201" count="3" x="-88714" y="-220353" z="-7900" radius="220" variant="MAGE" />
			</objective>
			<objective type="ACTIVATE" text="Awaken the Trial Seals" npcId="900242" count="3">
				<spawn npcId="900242" x="-88575" y="-220210" z="-7900" />
				<spawn npcId="900242" x="-88853" y="-220496" z="-7900" />
				<spawn npcId="900242" x="-88856" y="-220215" z="-7896" />
				<spawn npcId="900200" count="2" x="-88714" y="-220353" z="-7900" radius="150" />
			</objective>
			<objective type="SURVIVE" text="Hold your ground" seconds="60" interval="15" maxAlive="6">
				<spawn npcId="900200" count="2" x="-88856" y="-220215" z="-7896" radius="150" />
			</objective>
			<objective type="BOSS" text="Defeat the Trial Guardian">
				<spawn npcId="900204" x="-88856" y="-220215" z="-7896" heading="57508" waves="2" />
			</objective>
			<objective type="TALK" text="Speak with the Trial Master" npcId="900241" x="-88998" y="-220077" z="-7892" heading="57508" />
		</objectives>
		<rewards>
			<arenaCoins count="10" parBonus="5" />
			<sealedCache />
		</rewards>
	</challenge>
	<mapping stage="FIRST_TRANSFER" type="ARCHETYPE" value="FIGHTER" challenge="first_vanguard" />
	<mapping stage="FIRST_TRANSFER" type="ARCHETYPE" value="MAGE" challenge="first_arcane" />
	<mapping stage="FIRST_TRANSFER" type="GENERIC" challenge="first_vanguard" />
</list>
