<?xml version="1.0" encoding="UTF-8"?>
<!--
  Passive Tree active/master skills - Batch 1.

  Only the CONFIRMED effect pattern is used here:
    <effect name="{Stat.value, capitalized}"><power>N</power><type>PER|DIFF</type></effect>
  matching e.g. Stat.MAX_HP("maxHp") -> effect name "MaxHp", verified against
  your own Body of Avatar skill.

  Two skills from the original design are DELIBERATELY OMITTED here rather
  than guessed:
    - 90340 Arcane Nova (AoE damage nuke)
    - 90350 Benediction (party heal)
  Faking these with an unconfirmed effect name would let them load and cast
  with zero actual damage/healing - a silent failure a player would only
  discover mid-fight. Send one damage-effect skill and one heal-effect skill
  from your data and these two will be finished properly, not guessed.

  The remaining four below are simplified relative to their original flavor
  text (no teleport, no AoE debuff, no cleanse) because those mechanics also
  have no confirmed effect name yet - each is now a straightforward,
  100%-safe self buff instead.
-->
<list xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../xsd/skills.xsd">
	<!-- 90300: Vanguard Aegis - was "barrier + taunt", simplified to a strong
	     temporary defensive buff. AbsorbDam is a reasonable-confidence guess
	     (Stat.ABSORB_DAMAGE_PERCENT = "absorbDam" -> "AbsorbDam") but is LESS
	     certain than PDef/MDef - watch your server log on first load for an
	     "unknown effect" warning naming it specifically if it's wrong. -->
	<skill id="90300" levels="1" name="Vanguard Aegis">
		<icon>icon.skill0000</icon>
		<operateType>A2</operateType>
		<targetType>SELF</targetType>
		<isMagic>0</isMagic>
		<magicLevel>1</magicLevel>
		<mpConsume>30</mpConsume>
		<hitTime>1000</hitTime>
		<reuseDelay>90000</reuseDelay>
		<abnormalType>NONE</abnormalType>
		<abnormalTime>30</abnormalTime>
		<effects>
			<effect name="PDef">
				<power>30</power>
				<type>PER</type>
			</effect>
			<effect name="MDef">
				<power>30</power>
				<type>PER</type>
			</effect>
			<effect name="AbsorbDam">
				<power>15</power>
				<type>PER</type>
			</effect>
		</effects>
	</skill>

	<!-- 90310: War Cry - was "self buff + AoE enemy P.Def debuff", simplified
	     to a pure self P.Atk / Attack Speed buff (the AoE-debuff-plus-self-buff
	     split would need the <selfEffects> block, whose internal shape is
	     confirmed different from <effects> but not confirmed in detail). -->
	<skill id="90310" levels="1" name="War Cry">
		<icon>icon.skill0000</icon>
		<operateType>A2</operateType>
		<targetType>SELF</targetType>
		<isMagic>0</isMagic>
		<magicLevel>1</magicLevel>
		<mpConsume>25</mpConsume>
		<hitTime>1000</hitTime>
		<reuseDelay>60000</reuseDelay>
		<abnormalType>NONE</abnormalType>
		<abnormalTime>20</abnormalTime>
		<effects>
			<effect name="PAtk">
				<power>12</power>
				<type>PER</type>
			</effect>
			<effect name="PAtkSpd">
				<power>10</power>
				<type>PER</type>
			</effect>
		</effects>
	</skill>

	<!-- 90320: Shadow Step - was "teleport behind + bonus crit on next hit",
	     simplified to a burst self Critical Damage buff. Teleport/blink has
	     no confirmed effect name, so it is omitted rather than guessed. -->
	<skill id="90320" levels="1" name="Shadow Step">
		<icon>icon.skill0000</icon>
		<operateType>A2</operateType>
		<targetType>SELF</targetType>
		<isMagic>0</isMagic>
		<magicLevel>1</magicLevel>
		<mpConsume>20</mpConsume>
		<hitTime>500</hitTime>
		<reuseDelay>30000</reuseDelay>
		<abnormalType>NONE</abnormalType>
		<abnormalTime>10</abnormalTime>
		<effects>
			<effect name="CritDmg">
				<power>20</power>
				<type>PER</type>
			</effect>
		</effects>
	</skill>

	<!-- 90330: Disengage & Strafe - was "leap back + cleanse slows + speed",
	     simplified to a burst Run Speed buff. Cleanse/dispel-by-category has
	     no confirmed effect name here, so it is omitted rather than guessed. -->
	<skill id="90330" levels="1" name="Disengage &amp; Strafe">
		<icon>icon.skill0000</icon>
		<operateType>A2</operateType>
		<targetType>SELF</targetType>
		<isMagic>0</isMagic>
		<magicLevel>1</magicLevel>
		<mpConsume>15</mpConsume>
		<hitTime>500</hitTime>
		<reuseDelay>40000</reuseDelay>
		<abnormalType>NONE</abnormalType>
		<abnormalTime>5</abnormalTime>
		<effects>
			<effect name="RunSpeed">
				<power>30</power>
				<type>DIFF</type>
			</effect>
		</effects>
	</skill>
</list>
