<!--
	Passive tree ACTIVE skills - batch 1 (5 skills).

	Place in your server's skill data folder alongside the retail skill files
	(data/stats/skills/, or a custom/ subfolder if your loader scans recursively).

	What is CONFIRMED from your own data vs. what to verify
	=======================================================
	CONFIRMED  - overall <skill> structure, operateType A1/A2, targetType,
	             abnormal* fields                         (your Body of Avatar)
	CONFIRMED  - every stat="..." string below comes straight from your
	             Stat.java (pDef, mDef, pAtk, mAtk, pAtkSpd, critDmg, rShld)
	CONFIRMED  - <selfEffects>, <flyType>, <activateRate>, <basicProperty>,
	             <trait>, <isDebuff>, <effectPoint> exist in your skills.xsd
	VERIFY     - the effect HANDLER names: Buff, PhysicalAttack, Stun,
	             TeleportToTarget. Run the PowerShell one-liner in README.txt
	             to list every handler name your datapack actually uses.

	All five use abnormalType NONE so they stack independently of retail
	buffs (Shield, Might, Haste...) instead of overwriting them. Change to a
	retail type (e.g. PD_UP) if you WANT them to compete with retail buffs.
-->
<list>

	<!-- ===================================================================
	     90400  VANGUARD AEGIS   (Vanguard / tank)
	     Short, hard defensive cooldown: big P.Def/M.Def spike plus shield
	     block, for surviving a burst window - not something you keep up.
	     Retail reference for comparison: 110 Ultimate Defense.
	     =================================================================== -->
	<skill id="90400" levels="1" name="Vanguard Aegis">
		<icon>icon.skill0110</icon>
		<operateType>A2</operateType>
		<targetType>SELF</targetType>
		<abnormalLevel>1</abnormalLevel>
		<abnormalTime>20</abnormalTime>
		<abnormalType>NONE</abnormalType>
		<hitTime>1000</hitTime>
		<isMagic>0</isMagic> <!-- Physical Skill -->
		<magicLevel>40</magicLevel>
		<mpConsume>45</mpConsume>
		<reuseDelay>90000</reuseDelay>
		<effects>
			<effect name="Buff">
				<mul stat="pDef">1.30</mul>
				<mul stat="mDef">1.30</mul>
				<add stat="rShld">20</add> <!-- +20% block chance, only with a shield equipped -->
			</effect>
		</effects>
	</skill>

	<!-- ===================================================================
