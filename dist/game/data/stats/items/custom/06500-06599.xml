	<item id="6509" type="EtcItem" name="Sealed Cache (Epic)">
		<!-- Lucky Loot: Epic Sealed Cache (see config/Custom/LuckyLoot.ini). Always gives Dragon Coins, plus at least 4 random crafting materials: every material rolls on its own (rarer materials have a lower chance), and if too few hit, the table is rolled again until the minimum is reached. Each opening also has a very small chance of a treasure (enchant scrolls and better, the rarer the better). -->
		<set name="icon" val="icon.etc_treasure_box_i04" />
		<set name="default_action" val="PEEL" />
		<set name="immediate_effect" val="true" />
		<set name="material" val="FISH" />
		<set name="weight" val="100" />
		<set name="price" val="1157" />
		<set name="is_stackable" val="true" />
		<set name="is_oly_restricted" val="true" />
		<set name="handler" val="ExtractableItems" />
		<!-- extractableCountMin/Max count distinct items, Dragon Coins included. Max is kept well above the expected roll count so the table order doesn't bias which materials drop. A re-roll (too few hits) rolls the treasures again too, so their real chance is about 5-15% above the listed one. -->
		<set name="extractableCountMin" val="5" />
		<set name="extractableCountMax" val="22" />
		<capsuled_items>
			<item id="3481" min="5000" max="50000" chance="100" /> <!-- Dragon Coin (always) -->
			<!-- Treasures: the rarer, the better. Listed right after the coins so the extractableCountMax cap can never cut them off. Anything listed at or below SealedCacheTreasureChance (LuckyLoot.ini) is shown on screen with a fanfare, and at or below SealedCacheAnnounceChance it is announced to every online player. -->
			<item id="730" min="1" max="1" chance="1" /> <!-- Scroll: Enchant Armor (A-Grade) -->
			<item id="729" min="1" max="1" chance="0.5" /> <!-- Scroll: Enchant Weapon (A-Grade) -->
