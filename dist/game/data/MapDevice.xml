	<tier tier="4" itemId="50104" minLevel="81" maxLevel="82" dropLevel="81" hp="1.25" attack="1.12" defence="1.08" reward="1.30" />
	<tier tier="5" itemId="50105" minLevel="82" maxLevel="83" dropLevel="82" hp="1.35" attack="1.16" defence="1.10" reward="1.45" />
